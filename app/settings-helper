#!/usr/bin/python3 -I
"""Privileged helper for Linux Hello Camera.

Runs as root through pkexec. It only ever acts on the account of the user
who invoked pkexec, and only accepts a fixed set of commands and config keys.

Commands:
    enroll                     add the caller's face (streams PROGRESS lines)
    remove-face ID             delete one of the caller's face entries (a number from `list`)
    clear-faces                delete all of the caller's face data
    test                       run a recognition attempt, prints one JSON line
    set-encryption on|off|auto lock face data to the security chip (TPM) or not; the engine
                               converts the stored face data (use this, not `set`, for it)
    set KEY=VALUE [...]        change options in /etc/linux-hello-camera/config.yaml
                               (dotted keys, e.g. recognition.threshold=0.5)
    pam-enable SERVICE...      add the face unlock lines to /etc/pam.d/SERVICE
    pam-disable SERVICE...     remove them again
    pam-refresh                rewrite every service that has face unlock with the current lines
                               (upgrades)
"""

import glob
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import linux_hello_camera_common as common  # noqa: E402

CONFIG_PATH = common.CONFIG_PATH
ENGINE = common.ENGINE
ENROLL_COUNT = 5

PAM_MARK = "# linux-hello-camera"
PAM_MODULE = "pam_linux_hello_camera.so"
PAM_MODULE_GLOB = "/usr/lib*/security/" + PAM_MODULE
PAM_LINE = f"auth       sufficient   {PAM_MODULE}   {PAM_MARK}\n"
# GNOME: gdm-password. KDE Plasma: sddm or plasmalogin (login), kde (lock screen)
PAM_SERVICES = ("sudo", "polkit-1", "gdm-password", "sddm", "plasmalogin", "kde-fingerprint", "kde")
# The Plasma lock screen runs kde-fingerprint in the background as soon as it wakes up, next to
# the password prompt (kde). Face unlock lives there so it starts without pressing Enter. Older
# versions used kde, so switching kde-fingerprint also cleans that up.
PAM_REPLACES = {"kde-fingerprint": "kde"}
# Plasma starts kde-fingerprint as soon as the mouse moves, so there the face check sits behind a
# gate that waits for a key press or click. A correct password in the second service releases it.
GATE = common.LIB_DIR + "/input-gate"
PAM_GATES = {"kde-fingerprint": "kde"}
PAM_GATE_LINE = f"auth       requisite    pam_exec.so quiet quiet_log {GATE}   {PAM_MARK}\n"
PAM_RELEASE_LINE = f"auth       optional     pam_exec.so quiet quiet_log {GATE} --release   {PAM_MARK}\n"
# For sudo and admin prompts the confirmation dialog opens before the face check (see
# confirm-broker); "failed" only runs when the face check didn't approve.
BROKER = common.LIB_DIR + "/confirm-broker"
CONFIRM_SERVICES = ("sudo", "polkit-1")
PAM_CONFIRM_START = f"auth       optional     pam_exec.so seteuid quiet quiet_log {BROKER} start   {PAM_MARK}\n"
PAM_CONFIRM_FAILED = f"auth       optional     pam_exec.so seteuid quiet quiet_log {BROKER} failed   {PAM_MARK}\n"
PAM_DIR = "/etc/pam.d"
VENDOR_PAM_DIR = "/usr/lib/pam.d"
BACKUP_SUFFIX = ".linux-hello-camera.bak"

# Dotted config key -> rule. Mirrors DESIGN.md: anything not listed here can't be changed.
BOOL = ("bool",)
DETECTION_MODELS = ("yolov8n-face.onnx",)
RECOGNITION_MODELS = ("edgeface_s_gamma_05.onnx", "edgeface_xs_gamma_06.onnx")
ANTISPOOF_MODELS = ("minifas_v2.onnx", "mobilenetv3_antispoof.onnx")
CONFIG_SCHEMA = {
    "disabled": BOOL,
    "camera": ("device",),
    "timeout_ms": ("int", 1000, 15000),
    "abort_if_lid_closed": BOOL,
    "abort_if_ssh": BOOL,
    "detection.model": ("choice", DETECTION_MODELS),
    "detection.threshold": ("float", 0.1, 0.95),
    "recognition.model": ("choice", RECOGNITION_MODELS),
    "recognition.threshold": ("float", 0.30, 0.90),
    "recognition.frames_needed": ("int", 1, 3),
    "storage.tpm_encryption": ("choice", ("auto", "on", "off")),
    "ir_liveness.enabled": BOOL,
    "ir_liveness.min_pairs": ("int", 1, 3),
    "ir_liveness.min_face_gain": ("float", 0.0, 255.0),
    "ir_liveness.min_gain_ratio": ("float", 1.0, 10.0),
    "ai_antispoof.enabled": BOOL,
    "ai_antispoof.model": ("choice", ANTISPOOF_MODELS),
    "ai_antispoof.threshold": ("float", 0.0, 1.0),
    "confirm.enabled": BOOL,
    "confirm.timeout_s": ("int", 5, 60),
}

# Face images are plain file names like 1.png or face_20261002-1403.png, never paths
FACE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\.png")


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def calling_user():
    uid = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID")
    if uid is None or not uid.isdigit():
        die("This helper must be started through pkexec.")
    try:
        name = pwd.getpwuid(int(uid)).pw_name
    except KeyError:
        die("Unknown calling user.")
    if name == "root":
        die("Refusing to manage face data for root.")
    return name


def engine_env():
    return {"PATH": "/usr/bin:/bin", "LANG": os.environ.get("LANG", "C.UTF-8")}


def write_atomic(path, text, mode):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".linux-hello-camera-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


# ---------------------------------------------------------------- faces

# Entry ids from `list` are digits only (milliseconds since the epoch)
FACE_ID = re.compile(r"[0-9]{1,20}", re.ASCII)


def cmd_enroll(user):
    # Forward the engine's lines one by one, flushed, so the app can show progress live.
    # Enrolling always adds to what is there.
    proc = subprocess.Popen([ENGINE, "enroll", "--username", user, "--count", str(ENROLL_COUNT)],
                            env=engine_env(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, errors="replace")
    for line in proc.stdout:
        print(line.rstrip("\n"), flush=True)
    return proc.wait()


def check_face_id(face_id):
    if not FACE_ID.fullmatch(face_id):
        die("Invalid face id.")
    return face_id


def engine_reply(args):
    """Run an engine command that answers with one JSON line and pass the line on."""
    proc = subprocess.run([ENGINE, *args], env=engine_env(), stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace")
    lines = [l for l in proc.stdout.splitlines() if l.startswith("{")]
    if lines:
        print(lines[-1], flush=True)
    return proc.returncode


def cmd_remove_face(user, face_id):
    return engine_reply(["remove", "--username", user, "--id", check_face_id(face_id)])


def cmd_set_encryption(value):
    if value not in common.TPM_SETTINGS:
        die("set-encryption takes on, off or auto")
    return engine_reply(["set-encryption", value])


def cmd_clear_faces(user):
    return engine_reply(["clear", "--username", user])


def cmd_test(user):
    # One JSON line is the whole answer; anything else the engine printed is noise
    return engine_reply(["test", "--username", user])


# ---------------------------------------------------------------- config

def validate(key, value):
    """The value for KEY as the right Python type, or exit with a message."""
    if key not in CONFIG_SCHEMA:
        die(f"Unknown or unsupported option: {key}")
    rule = CONFIG_SCHEMA[key]
    kind = rule[0]
    if kind == "bool":
        if value not in ("true", "false"):
            die(f"{key} must be true or false")
        return value == "true"
    if kind == "device":
        if value == "":
            return value
        if not re.fullmatch(r"/dev/[A-Za-z0-9_./:-]+", value) or ".." in value:
            die(f"Invalid device path: {value}")
        if not os.path.exists(value):
            die(f"Device does not exist: {value}")
        return value
    if kind in ("int", "float"):
        lo, hi = rule[1], rule[2]
        try:
            num = int(value) if kind == "int" else float(value)
        except ValueError:
            die(f"{key} must be a number")
        if not lo <= num <= hi:
            die(f"{key} must be between {lo} and {hi}")
        return num
    if value not in rule[1]:
        die(f"{key} must be one of: {', '.join(rule[1])}")
    return value


def set_dotted(data, dotted, value):
    node = data
    *parents, last = dotted.split(".")
    for part in parents:
        if not isinstance(node.get(part), dict):
            node[part] = {}
        node = node[part]
    node[last] = value


def render_config(data):
    common.need_yaml()
    header = ("# Linux Hello Camera. The app changes this file through its helper; you can edit it\n"
              "# by hand too, but comments are not kept when the app saves a setting.\n")
    return header + common.yaml.safe_dump(data, sort_keys=False, default_flow_style=False)


def cmd_set(pairs):
    updates = {}
    for pair in pairs:
        key, sep, value = pair.partition("=")
        if not sep:
            die(f"Expected KEY=VALUE, got {pair!r}")
        updates[key.strip()] = validate(key.strip(), value.strip())

    try:
        # Start from the defaults so the saved file is complete; keys we don't know stay as they are
        data = common.load_config(CONFIG_PATH)
    except common.ConfigError as e:
        die(str(e))
    for key, value in updates.items():
        set_dotted(data, key, value)

    try:
        mode = os.stat(CONFIG_PATH).st_mode & 0o7777
    except FileNotFoundError:
        mode = 0o644
        os.makedirs(os.path.dirname(CONFIG_PATH), mode=0o755, exist_ok=True)
    write_atomic(CONFIG_PATH, render_config(data), mode)
    for key, value in updates.items():
        shown = str(value).lower() if isinstance(value, bool) else value
        print(f"{key} = {shown}")
    return 0


# ---------------------------------------------------------------- PAM

def check_service(service):
    if service not in PAM_SERVICES:
        die(f"Unsupported PAM service: {service}")
    return os.path.join(PAM_DIR, service)


def code_of(line):
    """The line without comments, or "" for a comment line."""
    stripped = line.strip()
    return "" if stripped.startswith("#") else stripped


def is_our_line(line):
    """A line this app added."""
    code = code_of(line)
    return bool(code) and (PAM_MODULE in code or PAM_MARK in code)


def is_module_line(line):
    """The line that runs the face check."""
    code = code_of(line)
    return bool(code) and PAM_MODULE in code


def copied_marker(line):
    """True for the comment that says we created this file from the vendor one."""
    return line.startswith(PAM_MARK + ": copied from ")


def auth_indexes(lines):
    return [i for i, l in enumerate(lines) if re.match(r"\s*-?auth\s", l)]


def load_pam(service):
    """Return (path, lines) of /etc/pam.d/SERVICE without our lines. If only the vendor file
    in /usr/lib/pam.d exists, start from a marked copy of it."""
    path = check_service(service)
    if os.path.exists(path):
        with open(path) as f:
            lines = f.readlines()
        ours = any(copied_marker(l) for l in lines)
        if not ours and not os.path.exists(path + BACKUP_SUFFIX):
            shutil.copy2(path, path + BACKUP_SUFFIX)
        vendor = next((l.split("copied from ", 1)[1].strip() for l in lines if copied_marker(l)), None)
    else:
        vendor = os.path.join(VENDOR_PAM_DIR, service)
        if not os.path.exists(vendor):
            die(f"No PAM configuration found for {service}")
        with open(vendor) as f:
            lines = f.readlines()
    lines = [l for l in lines if not copied_marker(l) and not is_our_line(l)]
    if vendor:
        # Remember that we created this override so disabling can remove it again
        at = 1 if lines and lines[0].startswith("#%PAM") else 0
        lines.insert(at, f"{PAM_MARK}: copied from {vendor}\n")
    return path, lines


def save_pam(path, lines):
    """Write the file, or delete it if it's just our untouched copy of the vendor file."""
    copied = next((l for l in lines if copied_marker(l)), None)
    if copied and not any(is_our_line(l) for l in lines):
        vendor = copied.split("copied from ", 1)[1].strip()
        try:
            with open(vendor) as f:
                if f.readlines() == [l for l in lines if l is not copied]:
                    os.remove(path)
                    return
        except FileNotFoundError:
            pass
    write_atomic(path, "".join(lines), 0o644)


def cmd_pam_enable(service):
    if not glob.glob(PAM_MODULE_GLOB):
        die(f"{PAM_MODULE} is not installed.")
    path, lines = load_pam(service)

    auth = auth_indexes(lines)
    # Go right before the fingerprint module if there is one, so the preauth checks
    # (nologin, faillock) above it still run first. Otherwise go to the top of auth.
    fprint = [i for i in auth if "pam_fprintd.so" in lines[i]]
    at = fprint[0] if fprint else (auth[0] if auth else None)
    if at is None:
        die(f"No auth section found in {path}")
    if service in PAM_GATES:
        lines[at:at] = [PAM_GATE_LINE, PAM_LINE]
    elif service in CONFIRM_SERVICES:
        lines[at:at] = [PAM_CONFIRM_START, PAM_LINE, PAM_CONFIRM_FAILED]
    else:
        lines[at:at] = [PAM_LINE]
    save_pam(path, lines)

    if service in PAM_GATES:
        # A correct password releases a gate that is still waiting for input
        rpath, rlines = load_pam(PAM_GATES[service])
        auth = auth_indexes(rlines)
        if not auth:
            die(f"No auth section found in {rpath}")
        rlines.insert(auth[-1] + 1, PAM_RELEASE_LINE)
        save_pam(rpath, rlines)

    print(f"Enabled face unlock for {service}")
    return 0


def cmd_pam_disable(service):
    for name in (service, PAM_GATES.get(service)):
        if name and os.path.exists(check_service(name)):
            save_pam(*load_pam(name))
    print(f"Disabled face unlock for {service}")
    return 0


def pam_file_has(service, test):
    try:
        with open(os.path.join(PAM_DIR, service)) as f:
            return any(test(l) for l in f)
    except OSError:
        return False


def cmd_pam_refresh():
    """Bring every service that has face unlock up to the current lines."""
    for service in PAM_SERVICES:
        # kde only ever has the gate's release line, which kde-fingerprint takes care of
        if service not in PAM_REPLACES.values() and pam_file_has(service, is_module_line):
            cmd_pam_enable(service)
    return 0


def main(argv):
    if os.geteuid() != 0:
        die("This helper must run as root (use pkexec).")
    if not argv:
        die(__doc__)
    cmd, args = argv[0], argv[1:]

    # Face images belong to whoever started pkexec. The system-wide commands below need no
    # user, so the installer and the package hooks can run them as plain root.
    if cmd in ("enroll", "remove-face", "clear-faces", "test"):
        user = calling_user()
        if cmd == "enroll" and not args:
            return cmd_enroll(user)
        if cmd == "remove-face" and len(args) == 1:
            return cmd_remove_face(user, args[0])
        if cmd == "clear-faces" and not args:
            return cmd_clear_faces(user)
        if cmd == "test" and not args:
            return cmd_test(user)
    if cmd == "set-encryption" and len(args) == 1:
        return cmd_set_encryption(args[0])
    if cmd == "set" and args:
        return cmd_set(args)
    if cmd == "pam-refresh" and not args:
        return cmd_pam_refresh()
    if cmd in ("pam-enable", "pam-disable") and args:
        for service in args:
            check_service(service)
        for service in args:
            if service in PAM_REPLACES:
                cmd_pam_disable(PAM_REPLACES[service])
            (cmd_pam_enable if cmd == "pam-enable" else cmd_pam_disable)(service)
        return 0
    die(__doc__)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
