#!/usr/bin/python3
"""Confirmation dialog for sudo and admin prompts, like Windows Hello.

Runs as the user in their desktop session. Prints "continue" or "cancel" and exits 0 only for
Continue; Cancel, Escape, closing the window or the timeout all mean cancel, and the prompt
falls back to the password.

    confirm-dialog --kind sudo|polkit [--detail TEXT] [--timeout SECONDS] [--wait]

With --wait (started by confirm-broker before the face check) it opens in a waiting
state, "Making sure it's you" with Continue greyed out, and reads the outcome on stdin:
    matched [SECONDS]   face recognised: Continue lights up, countdown starts
    failed              not recognised: say so and close
Without --wait the face has already been recognised.
"""

import argparse
import os
import pwd
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gdk", "4.0")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402


def display_name():
    entry = pwd.getpwuid(os.getuid())
    return entry.pw_gecos.split(",")[0].strip() or entry.pw_name


def avatar_texture():
    user = pwd.getpwuid(os.getuid()).pw_name
    for path in (f"/var/lib/AccountsService/icons/{user}", os.path.expanduser("~/.face.icon"),
                 os.path.expanduser("~/.face")):
        try:
            return Gdk.Texture.new_from_filename(path)
        except GLib.Error:
            continue
    return None


class ConfirmApp(Adw.Application):
    def __init__(self, args):
        super().__init__(application_id="io.github.linux_hello_camera.Confirm",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.args = args
        self.result = 1
        self.done = False
        self.remaining = 0
        self.countdown_id = 0
        self.stdin_buffer = b""

    def do_activate(self):
        name = display_name()
        self.name = name
        win = Adw.ApplicationWindow(application=self, title="Face unlock", default_width=420,
                                    resizable=False)
        win.connect("close-request", lambda *_: self.finish(1))
        self.win = win

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=6, margin_bottom=24, margin_start=24, margin_end=24)
        avatar = Adw.Avatar(size=72, text=name, show_initials=True, halign=Gtk.Align.CENTER)
        texture = avatar_texture()
        if texture:
            avatar.set_custom_image(texture)
        box.append(avatar)

        self.title = Gtk.Label(css_classes=["title-2"], wrap=True, justify=Gtk.Justification.CENTER)
        box.append(self.title)

        status = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        self.spinner = Adw.Spinner(width_request=16, height_request=16)
        self.body = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        status.append(self.spinner)
        status.append(self.body)
        box.append(status)

        if self.args.detail:
            frame = Gtk.Box(css_classes=["card"], margin_top=6)
            frame.append(Gtk.Label(label=self.args.detail, wrap=True, xalign=0, hexpand=True,
                                   css_classes=["monospace"], margin_start=12, margin_end=12,
                                   margin_top=10, margin_bottom=10))
            box.append(frame)

        self.countdown = Gtk.Label(css_classes=["dim-label", "caption"])
        box.append(self.countdown)

        buttons = Gtk.Box(spacing=12, homogeneous=True, margin_top=6)
        self.cancel = Gtk.Button(label="Cancel", css_classes=["pill"])
        self.cancel.connect("clicked", lambda *_: self.finish(1))
        self.allow = Gtk.Button(label="Continue", css_classes=["pill"])
        self.allow.connect("clicked", lambda *_: self.finish(0))
        buttons.append(self.cancel)
        buttons.append(self.allow)
        box.append(buttons)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar(show_title=False))
        view.set_content(box)
        win.set_content(view)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, keyval, *_: keyval == Gdk.KEY_Escape and self.finish(1))
        win.add_controller(keys)

        if self.args.wait:
            self.show_waiting()
            GLib.io_add_watch(sys.stdin.fileno(), GLib.PRIORITY_DEFAULT,
                              GLib.IOCondition.IN | GLib.IOCondition.HUP, self.on_stdin)
        else:
            self.show_recognised(self.args.timeout)
        win.present()

    # ------------------------------------------------ states

    def show_waiting(self):
        self.title.set_label("Making sure it's you")
        self.body.set_label("Look at the camera")
        self.spinner.set_visible(True)
        self.allow.set_sensitive(False)
        self.cancel.grab_focus()

    def show_recognised(self, seconds):
        self.title.set_label(f"Hi, {self.name}")
        if self.args.kind == "sudo":
            self.body.set_label("Face recognised. Allow this command to run as administrator?")
        else:
            self.body.set_label("Face recognised. Allow the app that's asking to get administrator access?")
        self.spinner.set_visible(False)
        self.allow.set_sensitive(True)
        self.allow.add_css_class("suggested-action")
        self.win.set_default_widget(self.allow)
        self.allow.grab_focus()
        self.remaining = seconds
        self.tick()
        self.countdown_id = GLib.timeout_add_seconds(1, self.tick)

    def show_failed(self):
        self.title.set_label("Couldn't recognise you")
        self.body.set_label("Type your password instead")
        self.spinner.set_visible(False)
        self.allow.set_sensitive(False)
        self.cancel.set_sensitive(False)
        GLib.timeout_add(2500, lambda: self.finish(1) and False)

    # ------------------------------------------------ events

    def on_stdin(self, fd, condition):
        data = os.read(fd, 256) if condition & GLib.IOCondition.IN else b""
        if not data:
            self.finish(1)  # the broker went away
            return False
        self.stdin_buffer += data
        while b"\n" in self.stdin_buffer:
            line, self.stdin_buffer = self.stdin_buffer.split(b"\n", 1)
            words = line.decode(errors="replace").split()
            if words[:1] == ["matched"] and not self.countdown_id:
                seconds = int(words[1]) if len(words) > 1 and words[1].isdigit() else self.args.timeout
                self.show_recognised(seconds)
            elif words[:1] == ["failed"]:
                self.show_failed()
        return True

    def tick(self):
        if self.remaining <= 0:
            self.finish(1)
            return False
        self.countdown.set_label(f"Cancels automatically in {self.remaining} s")
        self.remaining -= 1
        return True

    def finish(self, result):
        if not self.done:
            self.done = True
            self.result = result
            print("continue" if result == 0 else "cancel", flush=True)
            self.quit()
        return True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--kind", choices=("sudo", "polkit"), required=True)
    parser.add_argument("--detail", default="")
    parser.add_argument("--timeout", type=int, default=15)
    parser.add_argument("--wait", action="store_true")
    args = parser.parse_args()
    app = ConfirmApp(args)
    app.run([])
    return app.result


if __name__ == "__main__":
    sys.exit(main())
